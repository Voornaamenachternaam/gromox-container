container=docker

MYSQL_ROOT_PASS=${{ secrets.MYSQL_ROOT_PASS }}
MYSQL_HOST=gromox-db
MYSQL_USER="grommunio"
MYSQL_PASS=${{ secrets.MYSQL_PASS }}
MYSQL_DB="grommunio"

CHAT_MYSQL_ROOT_PASS=${{ secrets.MYSQL_ROOT_PASS }}
CHAT_MYSQL_HOST=chat-db
CHAT_MYSQL_USER="grochat"
CHAT_MYSQL_PASS=${{ secrets.MYSQL_PASS }}
CHAT_MYSQL_DB="grochat"

FILES_MYSQL_ROOT_PASS=${{ secrets.MYSQL_ROOT_PASS }}
FILES_MYSQL_HOST=files-db
FILES_MYSQL_USER="grofiles"
FILES_MYSQL_PASS=${{ secrets.MYSQL_PASS }}
FILES_MYSQL_DB="grofiles"

OFFICE_MYSQL_ROOT_PASS=${{ secrets.MYSQL_ROOT_PASS }}
OFFICE_MYSQL_HOST=office-db
OFFICE_MYSQL_USER="groffice"
OFFICE_MYSQL_PASS=${{ secrets.MYSQL_PASS }}
OFFICE_MYSQL_DB="groffice"

ARCHIVE_MYSQL_ROOT_PASS=${{ secrets.MYSQL_ROOT_PASS }}
ARCHIVE_MYSQL_HOST=archive-db
ARCHIVE_MYSQL_USER="groarchive"
ARCHIVE_MYSQL_PASS=${{ secrets.MYSQL_PASS }}
ARCHIVE_MYSQL_DB="groarchive"


CHAT_ADMIN_PASS=${{ secrets.CHAT_ADMIN_PASS }}
FILES_ADMIN_PASS=${{ secrets.FILES_ADMIN_PASS }}
ADMIN_PASS=admin

ORIGFQDN=mail.pallas.grommun.io  
FQDN=mail.pallas.grommun.io
ORIGDOMAIN=pallas.grommun.io
DOMAIN=pallas.grommun.io
RELAYHOST=""

REPO_USER="${{ secrets.REPO_USER }}"
REPO_PASS="${{ secrets.REPO_PASS }}"

CLEAR_DBS="true"

LOGFILE="/var/log/grommunio-setup.log"

CHAT_CONFIG="/etc/grommunio-chat/config.json"

ORGANIZATION="grommunio"
TIMEZONE="Europe/Vienna"
HTTP_PROXY_USER="localhost"
HTTP_PROXY_DOMAIN="localhost"

ENABLE_ARCHIVE="true"
ARCHIVE_HOST=gromox-archive

ENABLE_OFFICE="true"
OFFICE_HOST=gromox-office

ENABLE_FILES="true"
FILES_HOST=gromox-office

#Choose Install type, 0 for self signed and 2 for letsencrypt.
SSL_INSTALL_TYPE=0

SSL_COUNTRY="XX"
SSL_STATE="XX"
SSL_LOCALITY="X"
SSL_ORG="grommunio Appliance"
SSL_OU="IT"
SSL_EMAIL="admin@${DOMAIN}"
SSL_DAYS=30
SSL_PASS=grommunio

